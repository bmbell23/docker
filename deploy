#!/usr/bin/env bash
# Run by scripts/reconcile.sh when docker's main moves (docker#45's ./deploy contract).
# The third-party stacks stay manual (container-updates.sh bumps their images); two things
# are deployed here:
#   monitoring  (docker#104) the config is mounted as folders (docker#96), so a merge is live in
#               the containers at once and only needs applying: compose changed -> `up -d` (compose
#               recreates just the services that changed; never `down`); Prometheus rules/config or
#               alertmanager.yml or blackbox.yml changed -> check it, then POST /-/reload. A bad config fails the
#               deploy and the running one stays as it was.
#   dagu        (docker#68) when a merge changed the files its container reads at start (compose,
#               config.yaml, ssh_include), drain it and recreate it, checking for a newer image on
#               the way. The drain runs detached: it outlives this reconciler run and waits for it.
#   stacks      (docker#132) opted-in third-party stacks: when the files their containers read at
#               start change (compose, Dockerfile, mounted config), `up -d --build --force-recreate`.
#               Forced because single-file mounts keep the pre-pull copy (docker#96). First sight
#               of a stack only stamps it. A recreate cuts off whatever the container was doing.
set -uo pipefail
cd "$(dirname "$0")"

stamp_ok() {   # stamp_ok <name> <tracked paths...>: what's committed there was applied already
    local f="logs/deploy/$1-applied.sha256"; shift
    [ "$(cat "$f" 2>/dev/null)" = "$(git ls-files -s -- "$@" | sha256sum | cut -d' ' -f1)" ]
}
stamp() {      # stamp <name> <tracked paths...>
    local f="logs/deploy/$1-applied.sha256"; shift
    mkdir -p logs/deploy; git ls-files -s -- "$@" | sha256sum | cut -d' ' -f1 > "$f"
}

metric() {     # metric <container> <url> <name>: its value, empty while it doesn't answer
    docker exec "$1" wget -qO- "$2/metrics" 2>/dev/null | awk -v m="$3" '$1 == m { printf "%.3f\n", $2 }'
}

# reload <container> <url> <prefix>: POST /-/reload and wait (60 s) until a load *newer than the
# request* worked. Always reload: `up -d` only recreates the services whose compose entry changed,
# and the old success flag stays 1 on a config that never loaded (docker#127).
reload() {
    local i before now
    for i in $(seq 30); do before=$(metric "$1" "$2" "$3_last_reload_success_timestamp_seconds"); [ -n "$before" ] && break; sleep 2; done
    [ -n "$before" ] || return 1
    sleep 1   # the timestamp has 1 s resolution: a fresh container could tie with its own reload
    docker exec "$1" wget -qO- --post-data= "$2/-/reload" >/dev/null || return 1
    for i in $(seq 30); do
        now=$(metric "$1" "$2" "$3_last_reload_success_timestamp_seconds")
        awk -v ok="$(metric "$1" "$2" "$3_last_reload_successful")" -v a="$now" -v b="$before" \
            'BEGIN { exit !(ok == 1 && a != "" && a > b) }' && return 0
        sleep 2
    done
    return 1
}

deploy_monitoring() {
    local P=monitoring/prometheus A=monitoring/alertmanager/alertmanager.yml C=monitoring/docker-compose.yml
    local B=monitoring/blackbox/blackbox.yml
    local up=0 rc=0
    stamp_ok mon-compose "$C" && stamp_ok mon-prometheus "$P" && stamp_ok mon-alertmanager "$A" && stamp_ok mon-blackbox "$B" \
        && { echo "monitoring: config unchanged since the last apply; nothing to deploy"; return 0; }
    stamp_ok mon-compose "$C" || {
        echo "monitoring: compose changed; up -d"
        (cd monitoring && docker compose up -d) || { echo "monitoring: docker compose up -d failed"; return 1; }
        up=1
    }
    # Blackbox first: Prometheus may probe with a module that's new in this merge (docker#127).
    if [ "$up" = 1 ] || ! stamp_ok mon-blackbox "$B"; then
        if ! docker exec blackbox-exporter blackbox_exporter --config.file=/etc/blackbox/blackbox.yml --config.check; then
            echo "monitoring: blackbox.yml doesn't check; not reloaded, the old one keeps running"; rc=1
        elif reload blackbox-exporter http://localhost:9115 blackbox_exporter_config; then
            echo "monitoring: blackbox_exporter config applied"; stamp mon-blackbox "$B"
        else echo "monitoring: blackbox_exporter didn't load its config"; rc=1; fi
    fi
    if [ "$rc" != 0 ]; then
        echo "monitoring: Prometheus not reloaded either; its probes may need blackbox's new config"
    elif [ "$up" = 1 ] || ! stamp_ok mon-prometheus "$P"; then
        if ! docker exec prometheus promtool check config /etc/prometheus/prometheus.yml; then
            echo "monitoring: Prometheus config doesn't check; not reloaded, the old one keeps running"; rc=1
        else
            if reload prometheus http://localhost:9090 prometheus_config; then
                echo "monitoring: Prometheus config applied"; stamp mon-prometheus "$P"
            else echo "monitoring: Prometheus didn't load its config"; rc=1; fi
        fi
    fi
    if [ "$up" = 1 ] || ! stamp_ok mon-alertmanager "$A"; then
        if ! docker exec alertmanager amtool check-config /etc/alertmanager/alertmanager.yml; then
            echo "monitoring: alertmanager.yml doesn't check; not reloaded, the old one keeps running"; rc=1
        else
            if reload alertmanager http://localhost:9093 alertmanager_config; then
                echo "monitoring: Alertmanager config applied"; stamp mon-alertmanager "$A"
            else echo "monitoring: Alertmanager didn't load its config"; rc=1; fi
        fi
    fi
    [ "$up" = 0 ] || [ "$rc" != 0 ] || stamp mon-compose "$C"
    return $rc
}

deploy_dagu() {
    local STAMP=logs/deploy/dagu-applied.sha256
    if [ -f "$STAMP" ] && (cd dagu && sha256sum --quiet -c "../$STAMP") >/dev/null 2>&1; then
        echo "dagu: config unchanged since the last drain; nothing to deploy"
        return 0
    fi
    [ -r dagu/.drain.env ] || { echo "dagu config changed, but dagu/.drain.env is missing: see dagu/README.md"; return 1; }

    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if systemctl --user is-active -q dagu-drain; then
        echo "dagu: a drain is already running (systemctl --user status dagu-drain)"
        return 0
    fi
    systemd-run --user --unit=dagu-drain --collect "$PWD/scripts/dagu-drain.sh" --recreate \
        && echo "dagu: config changed; drain + recreate started (journalctl --user -u dagu-drain, logs/dagu-drain/)"
}

# Opted-in stacks: <dir>:<files its containers read at start>. Docs and helper scripts don't count.
STACKS=(
    "youtube-downloader:docker-compose.yml Dockerfile yt-dlp.conf config.yml"
)

deploy_stacks() {
    local entry dir f files rc=0
    for entry in "${STACKS[@]}"; do
        dir=${entry%%:*}; files=()
        for f in ${entry#*:}; do files+=("$dir/$f"); done
        stamp_ok "stack-$dir" "${files[@]}" && { echo "$dir: unchanged since the last apply"; continue; }
        if [ ! -f "logs/deploy/stack-$dir-applied.sha256" ]; then
            stamp "stack-$dir" "${files[@]}"; echo "$dir: first sight; stamped, not recreated"; continue
        fi
        echo "$dir: config changed; up -d --build --force-recreate"
        if (cd "$dir" && docker compose up -d --build --force-recreate); then
            stamp "stack-$dir" "${files[@]}"
        else
            echo "$dir: docker compose up -d failed"; rc=1
        fi
    done
    return $rc
}

rc=0
deploy_monitoring || rc=1
deploy_dagu || rc=1
deploy_stacks || rc=1
exit $rc
