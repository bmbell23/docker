#!/usr/bin/env bash
# Run by scripts/reconcile.sh when docker's main moves (docker#45's ./deploy contract).
# The third-party stacks stay manual; the one thing deployed here is Dagu itself (docker#68):
# when a merge changed the files its container reads at start (compose, config.yaml,
# ssh_include), drain it and recreate it, checking for a newer image on the way.
# The drain runs detached: it outlives this reconciler run and waits for it to finish.
set -uo pipefail
cd "$(dirname "$0")"

STAMP=logs/deploy/dagu-applied.sha256
if [ -f "$STAMP" ] && (cd dagu && sha256sum --quiet -c "../$STAMP") >/dev/null 2>&1; then
    echo "dagu: config unchanged since the last drain; nothing to deploy"
    exit 0
fi
[ -r dagu/.drain.env ] || { echo "dagu config changed, but dagu/.drain.env is missing: see dagu/README.md"; exit 1; }

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if systemctl --user is-active -q dagu-drain; then
    echo "dagu: a drain is already running (systemctl --user status dagu-drain)"
    exit 0
fi
systemd-run --user --unit=dagu-drain --collect "$PWD/scripts/dagu-drain.sh" --recreate \
    && echo "dagu: config changed; drain + recreate started (journalctl --user -u dagu-drain, logs/dagu-drain/)"
