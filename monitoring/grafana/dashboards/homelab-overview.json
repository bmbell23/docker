      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "node_load1{instance=~\"$host\"} / on(instance) count by (instance)(node_cpu_seconds_total{mode=\"idle\",instance=~\"$host\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
