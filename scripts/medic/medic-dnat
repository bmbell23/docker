#!/usr/bin/env bash
# medic-dnat <port>: delete DNAT rules for <port> whose target IP belongs to no running container
# (docker#143; the CLAUDE.md "works on 127.0.0.1, times out on the Tailscale IP" fix). Runs as root
# via the medic's one sudoers line, so it is installed as a root-owned COPY, never run from the repo:
#   sudo install -o root -g root -m 0755 scripts/medic/medic-dnat /usr/local/sbin/medic-dnat
#   echo 'brandon ALL=(root) NOPASSWD: /usr/local/sbin/medic-dnat' | sudo tee /etc/sudoers.d/medic
#   sudo chmod 0440 /etc/sudoers.d/medic && sudo visudo -cf /etc/sudoers.d/medic
# Deletes nothing else, and nothing at all if it can't list the running containers.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
port="${1:-}"
[[ "$port" =~ ^[0-9]{1,5}$ ]] || { echo "usage: medic-dnat <port>" >&2; exit 2; }

# Rules first, containers second: a container started in between then has a live IP, never
# a "stale" one.
rules=$(iptables -t nat -S DOCKER | grep -E -- "-p tcp .*--dport $port -j DNAT --to-destination " || true)
ids=$(docker ps -q) || { echo "docker ps failed; deleting nothing" >&2; exit 1; }
[ -n "$ids" ] || { echo "no running containers?; deleting nothing" >&2; exit 1; }
live=" $(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' $ids | tr '\n' ' ') "

n=0
while read -r line; do
    [ -n "$line" ] || continue
    read -ra rule <<<"$line"
    ip=${line##*--to-destination }; ip=${ip%%:*}
    [[ "$ip" =~ ^[0-9.]+$ ]] || continue
    [[ "$live" == *" $ip "* ]] && continue
    rule[0]=-D
    iptables -t nat "${rule[@]}"
    echo "deleted: $line"
    n=$((n + 1))
done <<<"$rules"
[ "$n" -gt 0 ] || echo "no stale DNAT rules for :$port"
